import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import matplotlib.pyplot as plt
import pyccl as ccl
import tqdm
import plotly.graph_objects as go
from plotly.subplots import make_subplots

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Device : {device}")

# ====================== PLANCK 2018 ======================
PLANCK_2018 = {
    'Omega_m': 0.3153,
    'sigma_Om': 0.0073,
    'mnu_max': 0.12
}

# ====================== SCALAR FIELD ======================
class LearnableScalarField(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(nn.Linear(1, 64), nn.Tanh(), nn.Linear(64, 64), nn.Tanh(), nn.Linear(64, 4))
    def forward(self, t):
        p = self.net(t)
        gamma   = torch.sigmoid(p[:,0:1]) * 1.5
        d_drag  = torch.sigmoid(p[:,1:2]) * 3.5 + 0.5
        Omega_m = torch.sigmoid(p[:,2:3]) * 0.1 + 0.25
        m_nu    = torch.sigmoid(p[:,3:4]) * 0.4
        return gamma, d_drag, Omega_m, m_nu

# ====================== DFE-NS3D ======================
def sdf_artery(x, y, z):
    return torch.sqrt(y**2 + (z - 0.5)**2) - 0.3

class DFE_NS3D(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(nn.Linear(4, 128), nn.Tanh(),
                                 nn.Linear(128, 128), nn.Tanh(),
                                 nn.Linear(128, 128), nn.Tanh(),
                                 nn.Linear(128, 5))
    def forward(self, x, y, z, t):
        out = self.net(torch.cat([x, y, z, t], dim=1))
        return out[:,0:1], out[:,1:2], out[:,2:3], out[:,3:4], torch.sigmoid(out[:,4:5])*0.01

# ====================== TRAINING ======================
def train_full_coupled(epochs=1500):
    scalar_field = LearnableScalarField().to(device)
    dfe = DFE_NS3D().to(device)
    
    optimizer = optim.AdamW(list(scalar_field.parameters()) + list(dfe.parameters()), lr=1e-3, weight_decay=1e-5)
    scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)
    
    rho, mu_base = 1.0, 0.001
    n_col = 4000
    
    x = torch.rand(n_col, 1, device=device).requires_grad_(True)
    y = (torch.rand(n_col, 1, device=device) - 0.5).requires_grad_(True)
    z = torch.rand(n_col, 1, device=device).requires_grad_(True)
    t = torch.rand(n_col, 1, device=device).requires_grad_(True)
    
    n_data = 800
    xd = torch.rand(n_data, 1, device=device).requires_grad_(True)
    yd = (torch.rand(n_data, 1, device=device) - 0.5).requires_grad_(True)
    zd = torch.rand(n_data, 1, device=device).requires_grad_(True)
    td = torch.rand(n_data, 1, device=device).requires_grad_(True)
    
    u_true = torch.sin(np.pi * xd) * torch.exp(-0.01 * td)
    v_true = torch.zeros_like(u_true)
    w_true = torch.zeros_like(u_true)
    mask = torch.rand(n_data, device=device) < 0.15
    u_true[mask] += 5.0 * (2*torch.rand(mask.sum(), 1, device=device) - 1)
    v_true[mask] += 5.0 * (2*torch.rand(mask.sum(), 1, device=device) - 1)
    w_true[mask] += 5.0 * (2*torch.rand(mask.sum(), 1, device=device) - 1)
    u_data = u_true.detach()
    v_data = v_true.detach()
    w_data = w_true.detach()
    
    for epoch in tqdm.tqdm(range(epochs), desc="Full Coupled v10 - Planck 2018"):
        optimizer.zero_grad()
        
        gamma, d_drag, Omega_m, m_nu = scalar_field(t)
        u, v, w, p, nu_t = dfe(x, y, z, t)
        mu_eff = mu_base + nu_t
        
        u_t = torch.autograd.grad(u, t, torch.ones_like(u), create_graph=True, retain_graph=True)[0]
        u_x = torch.autograd.grad(u, x, torch.ones_like(u), create_graph=True, retain_graph=True)[0]
        u_y = torch.autograd.grad(u, y, torch.ones_like(u), create_graph=True, retain_graph=True)[0]
        u_z = torch.autograd.grad(u, z, torch.ones_like(u), create_graph=True, retain_graph=True)[0]
        u_xx = torch.autograd.grad(u_x, x, torch.ones_like(u_x), create_graph=True)[0]
        u_yy = torch.autograd.grad(u_y, y, torch.ones_like(u_y), create_graph=True)[0]
        u_zz = torch.autograd.grad(u_z, z, torch.ones_like(u_z), create_graph=True)[0]
        
        v_t = torch.autograd.grad(v, t, torch.ones_like(v), create_graph=True, retain_graph=True)[0]
        v_x = torch.autograd.grad(v, x, torch.ones_like(v), create_graph=True, retain_graph=True)[0]
        v_y = torch.autograd.grad(v, y, torch.ones_like(v), create_graph=True, retain_graph=True)[0]
        v_z = torch.autograd.grad(v, z, torch.ones_like(v), create_graph=True, retain_graph=True)[0]
        v_xx = torch.autograd.grad(v_x, x, torch.ones_like(v_x), create_graph=True)[0]
        v_yy = torch.autograd.grad(v_y, y, torch.ones_like(v_y), create_graph=True)[0]
        v_zz = torch.autograd.grad(v_z, z, torch.ones_like(v_z), create_graph=True)[0]
        
        w_t = torch.autograd.grad(w, t, torch.ones_like(w), create_graph=True, retain_graph=True)[0]
        w_x = torch.autograd.grad(w, x, torch.ones_like(w), create_graph=True, retain_graph=True)[0]
        w_y = torch.autograd.grad(w, y, torch.ones_like(w), create_graph=True, retain_graph=True)[0]
        w_z = torch.autograd.grad(w, z, torch.ones_like(w), create_graph=True, retain_graph=True)[0]
        w_xx = torch.autograd.grad(w_x, x, torch.ones_like(w_x), create_graph=True)[0]
        w_yy = torch.autograd.grad(w_y, y, torch.ones_like(w_y), create_graph=True)[0]
        w_zz = torch.autograd.grad(w_z, z, torch.ones_like(w_z), create_graph=True)[0]
        
        p_x = torch.autograd.grad(p, x, torch.ones_like(p), create_graph=True)[0]
        p_y = torch.autograd.grad(p, y, torch.ones_like(p), create_graph=True)[0]
        p_z = torch.autograd.grad(p, z, torch.ones_like(p), create_graph=True)[0]
        
        conv_u = u*u_x + v*u_y + w*u_z
        conv_v = u*v_x + v*v_y + w*v_z
        conv_w = u*w_x + v*w_y + w*w_z
        lap_u = u_xx + u_yy + u_zz
        lap_v = v_xx + v_yy + v_zz
        lap_w = w_xx + w_yy + w_zz
        
        mom_u = rho * u_t + conv_u + p_x/rho - mu_eff * lap_u
        mom_v = rho * v_t + conv_v + p_y/rho - mu_eff * lap_v
        mom_w = rho * w_t + conv_w + p_z/rho - mu_eff * lap_w
        div = u_x + v_y + w_z
        
        loss_pde = torch.mean(mom_u**2 + mom_v**2 + mom_w**2 + div**2)
        
        phi = sdf_artery(x, y, z)
        wall_mask = torch.exp(-80 * torch.abs(phi))
        loss_wall = torch.mean(wall_mask * (u**2 + v**2 + w**2))
        
        u_d, v_d, w_d, _, _ = dfe(xd, yd, zd, td)
        err = (u_d - u_data)**2 + (v_d - v_data)**2 + (w_d - w_data)**2
        data_loss = torch.mean(torch.sqrt(err + 1e-4))
        
        source = 0.05 * d_drag.mean() * torch.sin(t)
        mom_u = mom_u + source
        mom_v = mom_v + source
        mom_w = mom_w + source
        loss_mom = torch.mean(mom_u**2 + mom_v**2 + mom_w**2)
        
        loss_planck = ((Omega_m.mean() - PLANCK_2018['Omega_m']) / PLANCK_2018['sigma_Om'])**2 + \
                      torch.relu(m_nu.mean() - PLANCK_2018['mnu_max'])**2 * 100.0
        
        loss_total = loss_pde + 5.0 * loss_wall + loss_mom + 1.2 * data_loss + 3.0 * loss_planck
        
        loss_total.backward()
        optimizer.step()
        scheduler.step()
        
        if epoch % 500 == 0:
            print(f"Epoch {epoch:4d} | Total: {loss_total.item():.4f} | Planck: {loss_planck.item():.4f}")
    
    return scalar_field, dfe

# ====================== VALIDATION P(k) v10 ======================
def validate_v10_final(model, res=128):
    model.eval()
    _x = torch.linspace(0, 1, res).to(device)
    _y = torch.linspace(0, 1, res).to(device)
    grid_x, grid_y = torch.meshgrid(_x, _y, indexing='ij')
    
    x_in = grid_x.reshape(-1, 1)
    y_in = grid_y.reshape(-1, 1)
    z_in = torch.full_like(x_in, 0.5)
    a_in = torch.full_like(x_in, 1.0)
    
    with torch.no_grad():
        u, v, w, p, delta = model(x_in, y_in, z_in, a_in)   # ← unpack tuple ici
    
    delta_2d = delta.reshape(res, res).cpu().numpy()
    delta_2d -= np.mean(delta_2d)
    
    delta_k = np.fft.fftshift(np.fft.fft2(delta_2d))
    pk_2d = np.abs(delta_k)**2
    
    y, x = np.indices(pk_2d.shape)
    center = (res-1)/2
    r = np.sqrt((x - center)**2 + (y - center)**2).astype(int)
    
    tbin = np.bincount(r.ravel(), pk_2d.ravel())
    nr = np.bincount(r.ravel())
    radial_profile = tbin / nr
    
    cosmo_ref = ccl.Cosmology(Omega_c=0.26, Omega_b=0.05, h=0.67, sigma8=0.81, n_s=0.96)
    k_theory = np.logspace(-2, 1, 100)
    pk_theory = ccl.linear_matter_power(cosmo_ref, k_theory, a=1.0)
    
    plt.figure(figsize=(10, 6))
    k_pinn = np.arange(len(radial_profile))
    valid = slice(2, res//2)
    plt.loglog(k_pinn[valid], radial_profile[valid]/np.max(radial_profile[valid]), 
               'o-', label='PINN v10 (Science Grade)', color='dodgerblue')
    plt.loglog(k_theory * (res/2), pk_theory/np.max(pk_theory), 
               '--', color='crimson', linewidth=2, label='ΛCDM Theory')
    plt.title("Validation Finale v10 : Spectre de Puissance Hydro-Cosmo")
    plt.xlabel("Échelle k")
    plt.ylabel("P(k) Normalisé")
    plt.legend()
    plt.grid(True, which="both", alpha=0.2)
    plt.show()

# ====================== LANCEMENT ======================
print("🚀 Lancement du modèle v10 Full Coupled avec Planck 2018...")
scalar_net, dfe_net = train_full_coupled(epochs=1500)

print("\n✅ Entraînement terminé. Validation du spectre de puissance...")
validate_v10_final(dfe_net, res=128)

print("\n🎉 Modèle v10 complet prêt pour le repo GitHub et xAI")
